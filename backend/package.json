{
  "name": "event-platform-backend",
  "version": "1.0.0",
  "description": "Backend for Event Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--use-system-ca node dist/index.js",
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsnd --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env NODE_OPTIONS=--use-system-ca ts-node --project tsconfig.json src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "cross-env NODE_OPTIONS=--use-system-ca ts-node --project tsconfig.json src/db/seed.ts",
    "reembed": "cross-env NODE_OPTIONS=--use-system-ca ts-node --project tsconfig.json src/scripts/reembed-events.ts",
    "test": "cross-env NODE_OPTIONS=--use-system-ca jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "globalTeardown": "<rootDir>/src/testTeardown.ts"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  }
}
